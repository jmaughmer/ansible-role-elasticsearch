# {{ ansible_managed }}
[Service]
{% if elasticsearch_memory_lock | bool %}
LimitMEMLOCK=infinity
{% endif %}
TimeoutStartSec={{ elasticsearch_systemd_timeout_start_sec }}
{% if (elasticsearch_keystore_password | string | length) > 0 %}
Environment="ES_KEYSTORE_PASSPHRASE_FILE={{ _es_keystore_passphrase_file }}"
{% endif %}
{% if (elasticsearch_tmp_dir | length) > 0 %}
Environment="ES_TMPDIR={{ elasticsearch_tmp_dir }}"
{% endif %}
{% for name, value in elasticsearch_systemd_environment | dictsort %}
Environment="{{ name }}={{ value }}"
{% endfor %}
